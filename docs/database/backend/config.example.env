ENV=development
DEBUG=true
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/multiagent_dev
JWT_SECRET_KEY=change-me-in-production

# Leave LLM_PROVIDER empty to run with LLM-backed agents disabled (they will
# return status=not_configured instead of fake data).
LLM_PROVIDER=
LLM_MODEL=
LLM_API_KEY=
LLM_BASE_URL=

SANDBOX_MODE=subprocess
MAX_REPAIR_ATTEMPTS=3
